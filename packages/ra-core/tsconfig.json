{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "allowJs": false,
        "strictNullChecks": true,
        "target": "ES2022",
        "moduleResolution": "bundler"
    },
    "exclude": [
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.spec.js",
        "**/*.stories.ts",
        "**/*.stories.tsx",
        "**/*.stories.js"
    ],
    "include": [
        "src"
    ]
}
