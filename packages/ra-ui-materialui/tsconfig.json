{
    "extends": "../../tsconfig.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "strictNullChecks": true,
        "target": "ES2022",
        "moduleResolution": "bundler",
        "module": "esnext",
        "baseUrl": "./",
        "ignoreDeprecations": "6.0",
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true
    },
    "exclude": [
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/*.spec.js",
        "**/*.stories.tsx"
    ],
    "include": [
        "src"
    ]
}
